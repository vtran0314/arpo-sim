<?xml version="1.0"?>
<sdf version="1.6">
  <model name="iris_drone">
    <static>true</static>

    <!-- Body -->
    <link name="base_link">
      <visual name="body_visual">
        <geometry>
          <mesh>
            <uri>model://iris_drone/meshes/iris.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.3 0.5 0.8 1</ambient>
          <diffuse>0.3 0.5 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="body_collision">
        <geometry>
          <box><size>0.47 0.47 0.11</size></box>
        </geometry>
      </collision>
    </link>

    <!-- Rotor 0: front-right CW -->
    <link name="rotor_0">
      <pose>0.13 -0.22 0.023 0 0 0</pose>
      <visual name="rotor_0_visual">
        <geometry>
          <mesh>
            <uri>model://iris_drone/meshes/iris_prop_cw.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- Rotor 1: back-left CCW -->
    <link name="rotor_1">
      <pose>-0.13 0.2 0.023 0 0 0</pose>
      <visual name="rotor_1_visual">
        <geometry>
          <mesh>
            <uri>model://iris_drone/meshes/iris_prop_ccw.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- Rotor 2: front-left CCW -->
    <link name="rotor_2">
      <pose>0.13 0.22 0.023 0 0 0</pose>
      <visual name="rotor_2_visual">
        <geometry>
          <mesh>
            <uri>model://iris_drone/meshes/iris_prop_ccw.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- Rotor 3: back-right CW -->
    <link name="rotor_3">
      <pose>-0.13 -0.2 0.023 0 0 0</pose>
      <visual name="rotor_3_visual">
        <geometry>
          <mesh>
            <uri>model://iris_drone/meshes/iris_prop_cw.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

  </model>
</sdf>
