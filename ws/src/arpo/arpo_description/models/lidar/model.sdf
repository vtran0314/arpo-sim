<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="lidar_3d_v2">
    <!--
      static=true: keeps the sensor in place without physics simulation.
      A ground sensor station doesn't need to fall or be pushed around.
    -->
    <static>true</static>

    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.07121186 0 0 0</pose>
        <mass>0.83</mass>
        <inertia>
          <ixx>0.002853261803275034</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.002853261803275034</iyy>
          <iyz>0</iyz>
          <izz>0.0029004988906384237</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.07121186 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08360116</radius>
            <length>0.14242372</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
           <uri>model://lidar/meshes/lidar_3d_v2.dae</uri>
          </mesh>
        </geometry>
      </visual>

     <sensor name="lidar" type="gpu_lidar">
        <!-- 5 cm above link origin so the sensor sits at the top of the housing -->
        <pose>0 0 0.15 0 0 0</pose>
        <topic>/lidar/scan</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <!-- 360° sweep, 640 rays → ~0.56° angular resolution -->
              <samples>640</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <!-- 16 channels spanning 0° to +30° vertical.
                   Sensor sits only 0.15 m above ground, so all downward beams
                   (-15° to 0°) immediately return ground hits, producing dense
                   concentric rings with no useful data. Shifting the entire FOV
                   upward dedicates all 16 channels to the airspace where drones fly. -->
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>0.52360</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>100.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
        <visualize>true</visualize>
      </sensor>

    </link>
  </model>
</sdf>
