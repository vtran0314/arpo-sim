# Workspace - cloned/built at runtime by entrypoint
ws/src/FastSwarmSim/
ws/build/
ws/install/
ws/log/

# Build artifacts inside arpo package directories
ws/src/arpo/*/build/
ws/src/arpo/*/install/
ws/src/arpo/*/log/

# Python bytecode
**/__pycache__/
**/*.pyc

# Docker environment variables (may contain secrets)
.env
